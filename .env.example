APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# UUID de empresa en 360Sys (catálogos, pedidos) y de la tienda (Culqi)
APP_UUID=
APP_UUID_TIENDA=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# Envío a distritos (precio de envío + costo de exceso). false => 0 al frontend y al pedido
SHIPPING_DISTRICT_ENABLED=true

# API del chatbot de pedidos (/api/chatbot). Header X-API-Key; vacío => todo 401
CHATBOT_API_KEY=
CHATBOT_RATE_LIMIT=300
CHATBOT_MAX_ITEMS=50
CHATBOT_RESERVA_HORAS=24

# Pasarelas de pago
CULQI_SECRET_KEY=
CULQI_PUBLIC_KEY=
IZIPAY_ENDPOINT=
IZIPAY_USERNAME=
IZIPAY_PASSWORD=

# Almacenamiento (DigitalOcean Spaces)
FILESYSTEM_DISK=local
DO_ACCESS_KEY_ID=
DO_SECRET_ACCESS_KEY=
DO_DEFAULT_REGION=
DO_BUCKET=
DO_ENDPOINT=
DO_URL=

L5_SWAGGER_GENERATE_ALWAYS=false
